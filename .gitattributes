# Auto detect text files
* text=auto

# Python
*.py text eol=lf

# Shell scripts
*.sh text eol=lf

# PowerShell
*.ps1 text eol=crlf

# Batch
*.bat text eol=crlf

# Markdown
*.md text eol=lf

# JSON/YAML
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary

# Prevent diffing large binaries
*.exe binary
*.dll binary
*.so binary