{
    "python": {
        "main": {
            "support":"3.12.X",
            "reason":"stable"
        },
        "if_not": {
            "support":"3.10.X",
            "reason":"older_to_stable"
        }
    },
    "if_no_python": {
        "throw_error":"PYTHON_NOT_INSTALLED",
        "panic":true,
        "what_to_do":"ASK_USER_ACTION"
    },
    "actions": {
        "PYTHON_NOT_INSTALLED": {
            "message": "Python environment path cannot be found"
        },
        "ASK_USER_ACTION": "Please provide the path to Python environment, or install it manually"
    }
}