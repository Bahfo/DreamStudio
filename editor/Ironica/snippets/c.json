        "REST_API_C": [
            "#include <stdio.h>",
            "#include <string.h>",
            "",
            "typedef struct",
            "{",
            "    const char *method;",
            "    const char *path;",
            "    const char *body;",
            "} ApiRequest;",
            "",
            "int api_handle(const ApiRequest *request)",
            "{",
            "    if (request == NULL)",
            "    {",
            "        return -1;",
            "    }",
