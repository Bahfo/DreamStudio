            "",
            "app = Flask(__name__)",
            "",
            "@app.route('/api/resource', methods=['GET', 'POST'])",
            "def handle_resource():",
            "    if request.method == 'POST':",
            "        data = request.get_json()",
            "        return jsonify({'status': 'created', 'data': data}), 201",
            "    return jsonify({'status': 'ok'}), 200",
            "",
