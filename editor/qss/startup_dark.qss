/* DreamStudio solution start window - dark theme. */

QMainWindow#SolutionStartWindow {
    background: #1E1E1E;
}

QWidget#SolutionStartCentral {
    background: #1E1E1E;
}

QFrame#SolutionTopBar {
    background: #1E1E1E;
    border: none;
    border-bottom: 1px solid #333333;
}

QLabel#SolutionBrandLabel {
    color: #FFFFFF;
    font-size: 30px;
    font-weight: 600;
}

QLabel#SolutionTitleLabel {
    color: #FFFFFF;
    font-size: 34px;
    font-weight: 300;
}

QLabel#SolutionSubtitleLabel {
    color: #CCCCCC;
    font-size: 20px;
    font-weight: 400;
}

QLabel#SolutionHint {
    color: #9D9D9D;
    font-size: 13px;
}

QLabel#SolutionSelectionHint {
    color: #9D9D9D;
    font-size: 12px;
}

QLabel#SolutionSectionTitle {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 500;
}

QFrame#SolutionWelcomeActions {
    background: transparent;
    border: none;
}

QFrame#SolutionRecentPanel,
QFrame#SolutionLeftPanel {
    background: #1E1E1E;
    border: none;
}

QPushButton#SolutionPrimaryButton {
    background: #4F46E5;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 10px 28px;
    font-size: 14px;
}

QPushButton#SolutionPrimaryButton:hover {
    background: #5B5BD6;
}

QPushButton#SolutionPrimaryButton:disabled {
    background: #3A3A3A;
    color: #888888;
}

QPushButton#SolutionGhostButton {
    background: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #3E3E3E;
    border-radius: 4px;
    padding: 10px 18px;
    font-size: 13px;
}

QPushButton#SolutionGhostButton:hover {
    background: #3E3E3E;
    border-color: #6B6B6B;
}

QPushButton#SolutionLinkButton {
    background: transparent;
    border: none;
    color: #6EA8FE;
    font-size: 13px;
    text-decoration: none;
}

QPushButton#SolutionLinkButton:hover {
    color: #9CC3FF;
    text-decoration: underline;
}

QPushButton#SolutionActionCard {
    background: #252526;
    color: #FFFFFF;
    text-align: left;
    border: 1px solid #3E3E3E;
    border-radius: 6px;
    padding: 16px 18px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#SolutionActionCard:hover {
    background: #2D2D2D;
    border-color: #6EA8FE;
}

QPushButton#SolutionCloseBtn {
    background: transparent;
    text-align: center;
    border: none;
    width: 30px;
    height: 35px;
}

QPushButton#SolutionCloseBtn:hover {
    background: #7e2727;
}

QPushButton#SolutionMinBtn {
    background: transparent;
    text-align: center;
    border: none;
    width: 30px;
    height: 35px;
}

QPushButton#SolutionMinBtn:hover {
    background: #004c86;
}

QLabel#SolutionActionDesc {
    color: #9D9D9D;
    font-size: 12px;
}

QLineEdit#SolutionSearchBox {
    background: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E3E;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit#SolutionSearchBox:focus {
    border: 1px solid #6EA8FE;
}

QComboBox {
    background: #252526;
    color: #DDDDDD;
    border: 1px solid #3E3E3E;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 13px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #6B6B6B;
}

QComboBox QAbstractItemView {
    background: #252526;
    color: #FFFFFF;
    selection-background-color: #4F46E5;
}

QListWidget {
    background: transparent;
    border: none;
    color: #DDDDDD;
    font-size: 13px;
}

QListWidget::item {
    background: transparent;
    border: none;
}

QFrame#SolutionProjectCard {
    background: transparent;
    border: none;
    border-radius: 4px;
}

QFrame#SolutionProjectCard[selected="true"] {
    background: #333333;
    border: none;
}

QFrame#SolutionProjectCard:hover {
    background: #2D2D2D;
}

QLabel#SolutionProjectName {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 500;
}

QLabel#SolutionProjectDescription {
    color: #CCCCCC;
    font-size: 12px;
}

QLabel#SolutionTagPill {
    background: transparent;
    color: #DDDDDD;
    border: 1px solid #555555;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
}

QLabel#SolutionLangBadge {
    background: #3A3A3A;
    color: #DDDDDD;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}

QLabel#SolutionRecentPath {
    color: #9D9D9D;
    font-size: 11px;
}

QFrame#SolutionProjectIconFrame {
    background: transparent;
    border: none;
}

QMenu {
    background: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E3E;
}

QMenu::item {
    background: transparent;
    padding: 6px 22px;
}

QMenu::item:selected {
    background: #4F46E5;
    color: white;
}
