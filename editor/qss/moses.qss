/* ==========================================================================
   Moses — Material Evolution (Eye-Fatigue Optimized)
   A refined, modern evolution of the classic Material Theme (#263238)
   engineered for long-session comfort. WCAG-tuned desaturated teal
   #82aaff accents, warm off-white #eeffff text (not pure white),
   tonal elevation (#263238 → #2f3e46 → #37474f) and reduced
   vibration for 8h+ coding. Matte charcoal with soft blues/greys,
   inspired by Material Nova & Google Material 3 dark guidance.
   ========================================================================== */

/* ==========================================================================
   Global Defaults (canvas / backdrop)
   ========================================================================== */

QMainWindow, QWidget {
    background-color: #263238;
    color: #eeffff;
    font-size: 13px;
}

QToolTip {
    background-color: #2a373f;
    color: #eeffff;
    border: 1px solid #37474f;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 12px;
}

/* ==========================================================================
   Layout Primitives
   ========================================================================== */

QSplitter {
    background-color: #263238;
    border: none;
    width: 1px;
}

QSplitter::handle {
    background-color: #1e272e;
    border: none;
    width: 1px;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:pressed {
    background-color: #82aaff;
}

QFrame {
    background-color: #263238;
    border: none;
}

QLabel {
    color: #90a4ae;
    background: transparent;
    font-size: 13px;
}

/* ==========================================================================
   Generic Buttons
   ========================================================================== */

QPushButton, QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #eeffff;
    padding: 4px 8px;
}

QPushButton:hover, QToolButton:hover {
    background-color: #2e3c43;
    color: #eeffff;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #3b4d56;
}

QPushButton:disabled, QToolButton:disabled {
    color: #78909c;
}

QPushButton#exitButton {
    color: #eeffff;
}

QPushButton#destructiveButton {
    color: #f07178;
}

/* ==========================================================================
   Input Controls
   ========================================================================== */

QLineEdit {
    background-color: #2a373f;
    color: #b0bec5;
    border: 1px solid #37474f;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus {
    border: 1px solid #82aaff;
}

QLineEdit::placeholder {
    color: #78909c;
    font-style: italic;
}

QLineEdit#DreamStudioTitleBarSearch {
    background-color: transparent;
    border: none;
}

QPlainTextEdit {
    background-color: #1e272e;
    color: #b0bec5;
    border: none;
    font-family: "JetBrains Mono", "Consolas", "monospace";
    font-size: 13px;
    selection-background-color: #2f3e46;
}

QCheckBox {
    color: #eeffff;
    font-size: 12px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
}

/* ==========================================================================
   Generic Tree Views
   ========================================================================== */

QTreeView, QTreeWidget {
    background-color: #263238;
    color: #eeffff;
    border: none;
    outline: 0;
    font-size: 13px;
}

QTreeView::item, QTreeWidget::item {
    min-height: 22px;
    padding: 2px 4px;
}

QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: #314549;
}

QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: #2f3e46;
    color: #eeffff;
}

QTreeView::branch, QTreeWidget::branch {
    background: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:has-children:has-siblings:closed,
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:has-children:has-siblings:closed {
    border-image: none;
    image: url(assets/menus/expand_smaller.png);
    width: 12px;
    height: 12px;
}

QTreeView::branch:has-children:!has-siblings:open,
QTreeView::branch:has-children:has-siblings:open,
QTreeWidget::branch:has-children:!has-siblings:open,
QTreeWidget::branch:has-children:has-siblings:open {
    border-image: none;
    image: url(assets/menus/collapse_smaller.png);
    width: 12px;
    height: 12px;
}

QTreeWidget#PropertiesEnvTree::item {
    padding: 3px 4px;
    min-height: 26px;
}

QTreeWidget#PropertiesEnvTree::item:selected {
    background-color: #2f3e46;
    color: #eeffff;
}

QHeaderView::section {
    background-color: #263238;
    color: #78909c;
    padding: 4px 8px;
    border: none;
    border-right: 1px solid #1e272e;
    border-bottom: 1px solid #1e272e;
    font-size: 11px;
}

/* ==========================================================================
   Named Sidebar Tree Views
   ========================================================================== */

QTreeView#ExplorerTreeView,
QTreeView#GitGraphTreeView,
QTreeView#PanelTreeView {
    background-color: #263238;
    color: #eeffff;
    border: none;
    outline: none;
    font-size: 13px;
    selection-background-color: #2f3e46;
    selection-color: #eeffff;
}

QTreeView#ExplorerTreeView {
    alternate-background-color: #263238;
}

QTreeView#ExplorerTreeView::item,
QTreeView#GitGraphTreeView::item,
QTreeView#PanelTreeView::item {
    padding: 2px 4px;
    min-height: 22px;
    border: none;
}

QTreeView#ExplorerTreeView::item:hover,
QTreeView#GitGraphTreeView::item:hover,
QTreeView#PanelTreeView::item:hover {
    background-color: #314549;
}

QTreeView#ExplorerTreeView::item:selected,
QTreeView#GitGraphTreeView::item:selected,
QTreeView#PanelTreeView::item:selected {
    background-color: #2f3e46;
    color: #eeffff;
}

QTreeView#ExplorerTreeView::branch,
QTreeView#PanelTreeView::branch {
    background: transparent;
}

/* ==========================================================================
   Generic List Widgets
   ========================================================================== */

QListWidget {
    background-color: #263238;
    color: #eeffff;
    border: none;
    font-size: 12px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border: none;
}

QListWidget::item:hover {
    background-color: #314549;
}

QListWidget::item:selected {
    background-color: #2f3e46;
    color: #eeffff;
}

/* ==========================================================================
   Tables
   ========================================================================== */

QTableWidget {
    background-color: #263238;
    color: #b0bec5;
    border: none;
    gridline-color: transparent;
    outline: none;
}

QHeaderView {
    background-color: #263238;
    border: none;
}

QHeaderView::section {
    background-color: #263238;
    color: #78909c;
    font-weight: bold;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #2e3c43;
    text-align: left;
}

QTableWidget::item {
    padding: 8px 12px;
    border: none;
}

QTableWidget::item:hover {
    background-color: #314549;
    color: #eeffff;
}

QTableWidget::item:selected {
    background-color: #2f3e46;
    color: #ffffff;
}

QTableWidget::item:focus {
    outline: none;
    border: none;
}

/* ==========================================================================
   Tabs
   ========================================================================== */

QTabWidget::pane {
    border: 1px solid #1e272e;
    background-color: #263238;
    position: absolute;
    top: 0;
}

QTabBar {
    background-color: #263238;
    border-top: 1px solid #1e272e;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #263238;
    color: #90a4ae;
    font-size: 12px;
    padding: 5px 12px;
}

QTabBar::tab:hover {
    background-color: #27343e;
    color: #eeffff;
}

QTabBar::tab:selected {
    color: #eeffff;
    border-bottom: 2px solid #82aaff;
}

/* Editor Tab Bar */

DreamStudioIDETabBar {
    qproperty-selected_bg: #263238;
    qproperty-hover_bg: #232e35;
    qproperty-inactive_bg: #263238;
    qproperty-border_color: #82aaff;
    qproperty-hover_border_color: #263238;
    qproperty-inactive_border_color: #263238;
    qproperty-text_selected: #eeffff;
    qproperty-text_inactive: #90a4ae;
    qproperty-dirty_dot: #82aaff;
    qproperty-readonly_color: #f07178;
}

/* ==========================================================================
   Menus
   ========================================================================== */

QMenuBar {
    background-color: transparent;
    color: #eeffff;
    font-size: 13px;
    border: none;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 8px;
    margin: 0 2px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #2e3c43;
    color: #eeffff;
}

QMenu {
    background-color: #2f3e46;
    color: #eeffff;
    border: 1px solid #455a64;
    border-radius: 6px;
    padding: 4px;
    font-size: 13px;
}

QMenu::item {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 24px;
    min-height: 0;
}

QMenu::item:selected {
    background: #82aaff;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #78909c;
}

QMenu::separator {
    height: 1px;
    background: #455a64;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 4px;
}

QMenu::right-arrow {
    width: 10px;
    height: 10px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 4px;
    border: 1px solid #78909c;
    background-color: transparent;
}

QMenu::indicator:checked {
    background-color: #82aaff;
    border: 1px solid #82aaff;
}

/* ==========================================================================
   Combo Boxes & Abstract Item Views
   ========================================================================== */

QComboBox {
    background: transparent;
    color: #eeffff;
    border: none;
    padding-left: 5px;
}

QComboBox::drop-down {
    border: none;
    width: 0;
}

QAbstractItemView {
    background-color: #2f3e46;
    color: #eeffff;
    border: 1px solid #455a64;
    selection-background-color: #82aaff;
    outline: none;
    padding: 4px;
}

/* ==========================================================================
   Progress Bars
   ========================================================================== */

QProgressBar {
    background-color: #2f3e46;
    border: none;
    border-radius: 3px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #82aaff;
    border-radius: 3px;
}

/* ==========================================================================
   Global Scrollbars
   ========================================================================== */

QScrollBar:vertical,
QScrollBar:horizontal {
    background: transparent;
    margin: 0;
    border: none;
}

QScrollBar:vertical {
    width: 10px;
}

QScrollBar:horizontal {
    height: 10px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: rgba(120, 144, 156, 0.45);
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #546e7a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
}

/* ==========================================================================
   Title Bar (main window chrome stays on the canvas)
   ========================================================================== */

DreamStudioTitleBar,
QWidget#DreamStudioTitleBar {
    background-color: #263238;
}

DreamStudioTitleBar QPushButton {
    color: #eeffff;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    font-size: 13px;
}

DreamStudioTitleBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

DreamStudioTitleBar QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.16);
}

DreamStudioTitleBar QPushButton#btn_close:hover {
    background-color: #f07178;
    color: white;
}

DreamStudioTitleBar QPushButton#iconButton {
    background: transparent;
    border: none;
}

/* ==========================================================================
   Vertical Sidebar (tool window stripe lives on the canvas)
   ========================================================================== */

VerticalSidebar,
QFrame#VerticalSidebar {
    background-color: #263238;
    border-left: 1px solid #1e272e;
    border-right: 1px solid #1e272e;
}

VerticalSidebar QPushButton,
VerticalSidebar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: #eeffff;
    padding: 6px;
}

VerticalSidebar QPushButton:hover,
VerticalSidebar QToolButton:hover {
    background-color: #2e3c43;
    color: #eeffff;
}

VerticalSidebar QPushButton:pressed,
VerticalSidebar QToolButton:pressed {
    background-color: transparent;
}

/* ==========================================================================
   App Menu Bar
   ========================================================================== */

MenuBar, QMenu#MenuBar {
    background-color: #2f3e46;
    border: 1px solid #455a64;
    border-radius: 6px;
    padding: 4px;
    color: #eeffff;
    font-size: 13px;
}

MenuBar::item, QMenu#MenuBar::item {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 20px;
    min-height: 0;
}

MenuBar::item:selected, QMenu#MenuBar::item:selected {
    background: #82aaff;
    color: #ffffff;
}

/* ==========================================================================
   Workspace Container (canvas backdrop around the islands)
   ========================================================================== */

WorkspaceContainer QFrame {
    background-color: #263238;
}

WorkspaceContainer QLabel {
    border: none;
}

/* ==========================================================================
   Options Menu
   ========================================================================== */

OptionsMenu,
QFrame#OptionsMenu {
    background-color: #263238;
    border-bottom: 1px solid #1e272e;
}

OptionsMenu QPushButton,
OptionsMenu QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #eeffff;
    padding: 4px 8px;
}

OptionsMenu QPushButton:hover,
OptionsMenu QToolButton:hover {
    background-color: #2e3c43;
    color: #eeffff;
}

OptionsMenu QPushButton:pressed,
OptionsMenu QToolButton:pressed {
    background-color: #3b4d56;
}

OptionsMenu QFrame#Separator {
    background-color: #37474f;
}

/* ==========================================================================
   Sidebar Panels & Backdrops
   ========================================================================== */

QWidget#PropertiesExplorer,
QWidget#SolutionExplorer,
QWidget#GitVersionControl,
GitGraph,
QWidget#Panel,
QWidget#terminalSidebarHeader,
QStackedWidget#GitStackedWidget {
    background: transparent;
}

QFrame#PanelFrame {
    background-color: #263238;
    border-left: 1px solid #1e272e;
    border-right: 1px solid #1e272e;
}

QFrame#TODOSearchFrame {
    border: none;
}

QTableWidget#TODOSearchTable {
    border: none;
    background-color: #263238;
    color: #b0bec5;
}

QTableWidget#TODOSearchTable::item {
    padding: 4px;
}

QTableWidget#TODOSearchTable::item:hover {
    background-color: #27343e;
}

QTableWidget#TODOSearchTable::item:selected {
    background-color: #2f3e46;
    color: #ffffff;
}

QHeaderView#TODOSearchHeader::section {
    border: none;
    background: transparent;
    color: #eeffff;
    padding: 4px 8px;
    font-size: 11px;
}

/* ==========================================================================
   Sidebar Labels & Headers
   ========================================================================== */

QLabel#PropertiesTitle,
QLabel#ExplorerTitle,
QLabel#GitTitle,
QLabel#PanelTitle {
    color: #eeffff;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QLabel#PropertiesObjectLabel,
QLabel#ExplorerDirectoryLabel,
QLabel#PanelDirectoryLabel {
    color: #90a4ae;
    font-size: 12px;
    background: transparent;
    padding-right: 4px;
}

QLineEdit#ExplorerSearchBar:focus,
QLineEdit#PanelSearchBar:focus {
    border: 1px solid #82aaff;
}

/* ==========================================================================
   Sidebar Search & Rename Fields
   ========================================================================== */

QLineEdit#ExplorerSearchBar {
    background-color: #2a373f;
    color: #b0bec5;
    border: 1px solid #37474f;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 22px;
    selection-background-color: #2f3e46;
}

QLineEdit#PanelSearchBar {
    background-color: #2a373f;
    color: #b0bec5;
    border: 1px solid #37474f;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 22px;
    selection-background-color: #2f3e46;
}

QTreeView#ExplorerTreeView QLineEdit#ExplorerRenameEditor,
QLineEdit#PanelRenameEditor {
    background-color: #2a373f;
    color: #eeffff;
    border: 1px solid #82aaff;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
    font-size: 13px;
    selection-background-color: #2f3e46;
}

/* ==========================================================================
   Source Control / Git
   ========================================================================== */

QLabel#GitStatusLabel,
QLabel#GitInitDesc {
    color: #90a4ae;
    font-size: 12px;
    background: transparent;
}

QLabel#GitInitTitle {
    color: #eeffff;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QPushButton#GitInitButton,
QPushButton#GitCommitButton {
    background-color: #82aaff;
    color: white;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton#GitInitButton {
    border: none;
}

QPushButton#GitInitButton:hover,
QPushButton#GitCommitButton:hover {
    background-color: #82aaff;
}

QPushButton#GitCommitButton:disabled {
    background-color: #2f3e46;
    color: #78909c;
}

QTabWidget#GitWorkspaceTabs::pane {
    border: none;
    background-color: #263238;
}

QListWidget#GitChangesList {
    background-color: transparent;
    color: #eeffff;
    border: none;
    font-size: 12px;
    outline: none;
}

QListWidget#GitChangesList::item {
    padding: 4px 6px;
    border: none;
}

QListWidget#GitChangesList::item:hover {
    background-color: #27343e;
}

QListWidget#GitChangesList::item:selected {
    background-color: #2f3e46;
    color: #eeffff;
}

QTextEdit#GitCommitInput {
    background-color: #2a373f;
    color: #b0bec5;
    border: 1px solid #37474f;
    border-radius: 4px;
    font-size: 12px;
    selection-background-color: #2f3e46;
}

QTextEdit#GitCommitInput:focus {
    border: 1px solid #82aaff;
}

QFrame#GitCommitBox {
    background: transparent;
    border: none;
}

/* ==========================================================================
   Find and Replace
   ========================================================================== */

QFrame#FindReplaceMenu {
    background-color: #2a373f;
    border: 1px solid #37474f;
    border-radius: 6px;
}

QFrame#FindReplaceMenu QLineEdit {
    background-color: #263238;
    color: #b0bec5;
    border: 1px solid #2f3e46;
    border-radius: 3px;
    padding: 5px 6px;
    selection-background-color: #2f3e46;
}

QFrame#FindReplaceMenu QLineEdit:focus {
    border: 1px solid #82aaff;
    background-color: #1e272e;
}

QFrame#replaceContainer {
    background-color: #1e272e;
    border: 1px solid #2f3e46;
    border-radius: 3px;
}

QFrame#FindReplaceMenu QLineEdit#replaceInput {
    border: none;
    background-color: transparent;
}

QFrame#FindReplaceMenu QLineEdit#replaceInput:focus {
    border: none;
}

QFrame#FindReplaceMenu QPushButton {
    color: #b0bec5;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px;
    font-size: 12px;
}

QFrame#FindReplaceMenu QPushButton:hover {
    background-color: #2e3c43;
    color: #ffffff;
}

QFrame#FindReplaceMenu QPushButton:pressed {
    background-color: #82aaff;
    color: #ffffff;
}

QFrame#FindReplaceMenu QPushButton:checked {
    background-color: #3b4d56;
    border: 1px solid #82aaff;
    color: #ffffff;
}

QFrame#FindReplaceMenu QPushButton#btnReplaceAll {
    background-color: #27343e;
    border: 1px solid transparent;
    padding: 2px 8px;
    margin: 2px 0px;
}

QFrame#FindReplaceMenu QPushButton#btnReplaceAll:hover {
    background-color: #82aaff;
    color: #ffffff;
}

QFrame#menuSeparator {
    background-color: #37474f;
    max-height: 1px;
    margin: 4px 0px;
}

QFrame#FindReplaceMenu QLabel#tipLabel {
    color: #78909c;
    font-size: 11px;
    padding-bottom: 4px;
}

/* ==========================================================================
   Panels & Separators
   ========================================================================== */

QToolButton#PanelUndockButton,
QToolButton#PanelCloseButton {
    color: #90a4ae;
    font-size: 11px;
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 2px;
}

QToolButton#PanelUndockButton:hover,
QToolButton#PanelCloseButton:hover {
    background-color: #2e3c43;
    color: #eeffff;
}

QFrame#FloatingPanelFrame {
    background-color: #263238;
    border: 1px solid #82aaff;
}

QFrame#ToolbarSeparator {
    background-color: #2f3e46;
    border: none;
    max-width: 1px;
}

/* ==========================================================================
   Terminal
   ========================================================================== */

#terminalWorkspace {
    background-color: #263238;
    border: none;
}

QWidget#terminalSidebar {
    background-color: #263238;
    border: none;
}

QLabel#terminalSidebarTitle {
    color: #78909c;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    background: transparent;
}

QPushButton#terminalSidebarAddBtn {
    background: transparent;
    border: none;
    color: #eeffff;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#terminalSidebarAddBtn:hover {
    background-color: #2e3c43;
    color: #eeffff;
}

QListWidget#terminalSessionList {
    background: transparent;
    border: none;
    color: #eeffff;
    font-size: 12px;
    outline: none;
}

QListWidget#terminalSessionList::item {
    border: none;
    padding: 0;
}

QListWidget#terminalSessionList::item:hover {
    background-color: #27343e;
}

QListWidget#terminalSessionList::item:selected {
    background-color: #2f3e46;
}

QLabel#terminalSessionLabel {
    color: #eeffff;
    font-size: 12px;
    background: transparent;
}

QPushButton#terminalKillBtn {
    background: transparent;
    border: none;
    color: #78909c;
    font-size: 11px;
}

QPushButton#terminalKillBtn:hover {
    color: #f07178;
    background-color: rgba(255, 255, 255, 0.09);
}

QLabel#terminalPlaceholderTitle {
    color: #eeffff;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#terminalPlaceholderSubtitle {
    color: #78909c;
    font-size: 12px;
    background: transparent;
}

QSplitter#terminalWorkspaceSplitter::handle {
    background-color: #263238;
}

QWidget#terminalPanel {
    background-color: #263238;
    color: #eeffff;
}

QWidget#terminalPanel QPushButton {
    background-color: transparent;
    border: none;
    padding: 5px;
    color: #eeffff;
}

QWidget#terminalPanel QPushButton:hover {
    background-color: #2e3c43;
}

QWidget#terminalPanel QPushButton:checked {
    color: #82aaff;
    border: none;
}

QPlainTextEdit#terminalTextEdit {
    background-color: #1e272e;
    color: #b0bec5;
    border: none;
    font-size: 14px;
    selection-background-color: #2f3e46;
}

QPlainTextEdit#terminalOutputText {
    background-color: #1e272e;
    color: #b0bec5;
    border: none;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
}

QPushButton#terminalCloseBtn {
    background: transparent;
    border: none;
    color: #78909c;
    font-size: 12px;
}

QPushButton#terminalCloseBtn:hover {
    background-color: #f07178;
    color: white;
}

/* ==========================================================================
   Terminal Scrollbars
   ========================================================================== */

QScrollBar#terminalViewScrollbar:vertical,
QScrollBar#terminalViewScrollbar:horizontal,
QPlainTextEdit#terminalTextEdit QScrollBar:vertical,
QPlainTextEdit#terminalTextEdit QScrollBar:horizontal {
    background: #263238;
    margin: 0;
    border: none;
}

QScrollBar#terminalViewScrollbar:vertical,
QPlainTextEdit#terminalTextEdit QScrollBar:vertical {
    width: 8px;
}

QScrollBar#terminalViewScrollbar:horizontal,
QPlainTextEdit#terminalTextEdit QScrollBar:horizontal {
    height: 8px;
}

QScrollBar#terminalViewScrollbar::handle:vertical,
QScrollBar#terminalViewScrollbar::handle:horizontal,
QPlainTextEdit#terminalTextEdit QScrollBar::handle:vertical,
QPlainTextEdit#terminalTextEdit QScrollBar::handle:horizontal {
    background: rgba(120, 144, 156, 0.45);
    border-radius: 4px;
}

QScrollBar#terminalViewScrollbar::handle:vertical,
QPlainTextEdit#terminalTextEdit QScrollBar::handle:vertical {
    min-height: 24px;
}

QScrollBar#terminalViewScrollbar::handle:horizontal,
QPlainTextEdit#terminalTextEdit QScrollBar::handle:horizontal {
    min-width: 24px;
}

QScrollBar#terminalViewScrollbar::handle:vertical:hover,
QScrollBar#terminalViewScrollbar::handle:horizontal:hover,
QPlainTextEdit#terminalTextEdit QScrollBar::handle:vertical:hover,
QPlainTextEdit#terminalTextEdit QScrollBar::handle:horizontal:hover {
    background: #546e7a;
}

QScrollBar#terminalViewScrollbar::add-line:vertical,
QScrollBar#terminalViewScrollbar::sub-line:vertical,
QScrollBar#terminalViewScrollbar::add-line:horizontal,
QScrollBar#terminalViewScrollbar::sub-line:horizontal,
QPlainTextEdit#terminalTextEdit QScrollBar::add-line:vertical,
QPlainTextEdit#terminalTextEdit QScrollBar::sub-line:vertical,
QPlainTextEdit#terminalTextEdit QScrollBar::add-line:horizontal,
QPlainTextEdit#terminalTextEdit QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
    border: none;
}

QScrollBar#terminalViewScrollbar::add-page:vertical,
QScrollBar#terminalViewScrollbar::sub-page:vertical,
QScrollBar#terminalViewScrollbar::add-page:horizontal,
QScrollBar#terminalViewScrollbar::sub-page:horizontal,
QPlainTextEdit#terminalTextEdit QScrollBar::add-page:vertical,
QPlainTextEdit#terminalTextEdit QScrollBar::sub-page:vertical,
QPlainTextEdit#terminalTextEdit QScrollBar::add-page:horizontal,
QPlainTextEdit#terminalTextEdit QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
}

/* ==========================================================================
   Utility Tab Manager
   ========================================================================== */

UtilityTabManager {
    background-color: #263238;
    border: none;
}

QStackedWidget#UtilityStack,
QWidget#CodeEditor {
    background-color: #1e272e;
    border: none;
    color: #b0bec5;
    selection-background-color: #2f3e46;
    selection-color: #eeffff;
}

QWidget#CodeEditor {
    alternate-background-color: #1e272e;
}

QWidget#CodeEditor QFrame#DocumentationFlyout {
    background-color: #2a373f;
    border-left: 1px solid #1e272e;
}

QWidget#CodeEditor QFrame#IntelliSenseContainer {
    background-color: #2a373f;
    border: 1px solid #37474f;
}

QWidget#MiniMapHostWidget,
QWidget#MinimapPanel {
    background-color: #1e272e;
}

QWidget#CodeEditor QScrollBar:vertical,
QWidget#CodeEditor QScrollBar:horizontal {
    background: #1e272e;
}

UtilityTabBar {
    background-color: #263238;
    border: none;
}

UtilityTabBar::tab {
    background-color: #263238;
    color: #90a4ae;
    border: none;
    padding: 6px 12px;
    min-height: 20px;
}

UtilityTabBar::tab:selected {
    background-color: #2f3e46;
    color: #ffffff;
    border: none;
}

UtilityTabBar::tab:hover:!selected {
    background-color: #2e3c43;
    color: #eeffff;
}

/* ==========================================================================
   Status Bar
   ========================================================================== */

QFrame#StatusBar {
    background-color: #263238;
    border-top: 1px solid #1e272e;
}

QFrame#StatusBar QLabel,
QFrame#StatusBar QPushButton {
    background-color: transparent;
    border: none;
    color: #90a4ae;
    font-size: 12px;
    padding: 0 6px;
}

QFrame#StatusBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

QFrame#StatusBar QComboBox#zoomComboBox {
    background: transparent;
    color: #90a4ae;
    border: none;
    padding-left: 5px;
}

QFrame#StatusBar QComboBox#zoomComboBox::drop-down {
    border: none;
    width: 0;
}

QFrame#StatusBar QComboBox#zoomComboBox QAbstractItemView {
    background-color: #2f3e46;
    color: #eeffff;
    border: 1px solid #455a64;
    outline: none;
    padding: 4px;
}

QFrame#StatusBar QProgressBar#bootstrapProgress {
    background-color: rgba(255, 255, 255, 0.12);
    border: none;
    border-radius: 3px;
}

QFrame#StatusBar QProgressBar#bootstrapProgress::chunk {
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 3px;
}

QFrame#StatusBar QFrame#bootstrapProgressContainer {
    background: transparent;
    border: none;
}

/* ==========================================================================
   Bootstrap / System Init Modals
   ========================================================================== */

BootstrapDetailMenu#BootstrapDetailMenu {
    background-color: #2a373f;
    border: 1px solid #37474f;
    border-radius: 6px;
}

QFrame#BootstrapDetailTitleBar {
    background-color: #27343e;
    border-bottom: 1px solid #37474f;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QLabel#BootstrapDetailTitle {
    color: #eeffff;
    font-weight: 600;
    font-size: 13px;
    background: transparent;
    border: none;
}

QListWidget#bootstrapList {
    background-color: #263238;
    color: #eeffff;
    border: none;
    font-size: 12px;
    font-family: monospace;
    padding: 8px;
}

QListWidget#bootstrapList::item {
    padding: 4px 6px;
    border-bottom: 1px solid #1e272e;
}

/* ==========================================================================
   Dialogs & Status Indicators
   ========================================================================== */

QDialog#ExitDialog,
QDialog#ConfirmDialog,
QDialog#RenameDialog {
    background-color: #2a373f;
    color: #eeffff;
}

QPushButton#warningButton,
QPushButton#errorsButton,
QPushButton#statusButton,
QPushButton#terminalButton,
QPushButton#notificationButton {
    background: transparent;
    border: none;
    color: #90a4ae;
    font-size: 12px;
    padding: 0 10px;
}

QPushButton#warningButton:hover,
QPushButton#errorsButton:hover,
QPushButton#statusButton:hover,
QPushButton#terminalButton:hover,
QPushButton#notificationButton:hover {
    background-color: rgba(255, 255, 255, 0.09);
    color: #eeffff;
}

QLabel#lineColLabel,
QLabel#indentLabel,
QLabel#eolLabel {
    color: #90a4ae;
    font-size: 12px;
    padding: 0 6px;
    background: transparent;
}

QMenu#TitleBarMenu {
    min-width: 300px;
}

QMenu#TitleBarMenu::item {
    padding: 8px 14px;
}

/* ==========================================================================
   Notifications Panel
   ========================================================================== */

QFrame#NotificationCard {
    background-color: #263238;
    margin: 0px;
}

QFrame#NotificationCard:hover {
    background-color: #27343e;
}

QLabel#NotificationsTitle {
    color: #eeffff;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#NotificationTitle {
    color: #eeffff;
    border: none;
    background: transparent;
}

QLabel#NotificationMessage {
    color: #90a4ae;
    font-size: 10px;
    border: none;
    background: transparent;
}

QLabel#NotificationTimestamp {
    color: #82aaff;
    font-size: 10px;
    border: none;
    background: transparent;
}

QLabel#NotificationSource {
    color: #82aaff;
    font-size: 9px;
    border: none;
    background: transparent;
}

QPushButton#NotificationCloseBtn {
    border: none;
    color: #90a4ae;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
}

QPushButton#NotificationCloseBtn:hover {
    color: #eeffff;
    background-color: rgba(128, 128, 128, 0.2);
    border-radius: 4px;
}

QLabel#NotificationsCountLabel {
    color: #90a4ae;
    font-size: 10px;
    background: transparent;
    border: none;
}

QPushButton#NotificationsClearBtn {
    border: none;
    padding: 4px 8px;
    font-size: 10px;
    color: #82aaff;
    background: transparent;
}

QPushButton#NotificationsClearBtn:hover {
    background-color: rgba(128, 128, 128, 0.15);
    border-radius: 4px;
}

QLabel#NotificationsEmpty {
    color: #90a4ae;
    font-size: 11px;
    padding: 20px;
    background: transparent;
}
