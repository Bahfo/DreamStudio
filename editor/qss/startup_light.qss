/* DreamStudio solution start window - light theme. */

QMainWindow#SolutionStartWindow {
    background: #DFDFDF;
}

QWidget#SolutionStartCentral {
    background: #DFDFDF;
}

QFrame#SolutionTopBar {
    background: #DFDFDF;
    border: none;
    border-bottom: 1px solid #bcbcbc;
}

QLabel#SolutionBrandLabel {
    color: #1E1E1E;
    font-size: 30px;
    font-weight: 600;
}

QLabel#SolutionTitleLabel {
    color: #1E1E1E;
    font-size: 34px;
    font-weight: 300;
}

QLabel#SolutionSubtitleLabel {
    color: #444444;
    font-size: 20px;
    font-weight: 400;
}

QLabel#SolutionHint {
    color: #666666;
    font-size: 13px;
}

QLabel#SolutionSelectionHint {
    color: #666666;
    font-size: 12px;
}

QLabel#SolutionSectionTitle {
    color: #1E1E1E;
    font-size: 18px;
    font-weight: 500;
}

QFrame#SolutionWelcomeActions {
    background: transparent;
    border: none;
}

QFrame#SolutionRecentPanel,
QFrame#SolutionLeftPanel {
    background: #DFDFDF;
    border: none;
}

QPushButton#SolutionPrimaryButton {
    background: #4F46E5;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 10px 28px;
    font-size: 14px;
}

QPushButton#SolutionPrimaryButton:hover {
    background: #5B5BD6;
}

QPushButton#SolutionPrimaryButton:disabled {
    background: #CCCCCC;
    color: #888888;
}

QPushButton#SolutionGhostButton {
    background: #FFFFFF;
    color: #1E1E1E;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 10px 18px;
    font-size: 13px;
}

QPushButton#SolutionGhostButton:hover {
    background: #EAEAEA;
    border-color: #999999;
}

QPushButton#SolutionLinkButton {
    background: transparent;
    border: none;
    color: #0B5ED7;
    font-size: 13px;
    text-decoration: none;
}

QPushButton#SolutionLinkButton:hover {
    color: #084298;
    text-decoration: underline;
}

QPushButton#SolutionActionCard {
    background: #FFFFFF;
    color: #1E1E1E;
    text-align: left;
    border: 1px solid #DDDDDD;
    border-radius: 6px;
    padding: 16px 18px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#SolutionActionCard:hover {
    background: #EDEDF7;
    border-color: #4F46E5;
}

QPushButton#SolutionCloseBtn {
    background: transparent;
    color: #1E1E1E;
    text-align: center;
    border: none;
    width: 30px;
    height: 35px;
    font-size: 14px;
}

QPushButton#SolutionCloseBtn:hover {
    background: #b12828;
    color: white;
}

QPushButton#SolutionMinBtn {
    background: transparent;
    color: #1E1E1E;
    text-align: center;
    border: none;
    width: 30px;
    height: 35px;
    font-size: 14px;
}

QPushButton#SolutionMinBtn:hover {
    background: #17639d;
    color: white;
}

QLabel#SolutionActionDesc {
    color: #666666;
    font-size: 12px;
}

QLineEdit#SolutionSearchBox {
    background: #DFDFDF;
    color: #1E1E1E;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit#SolutionSearchBox:focus {
    border: 1px solid #4F46E5;
}

QComboBox {
    background: #DFDFDF;
    color: #1E1E1E;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 13px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #999999;
}

QComboBox QAbstractItemView {
    background: #DFDFDF;
    color: #1E1E1E;
    selection-background-color: #4F46E5;
    selection-color: white;
}

QListWidget {
    background: transparent;
    border: none;
    color: #1E1E1E;
    font-size: 13px;
}

QListWidget::item {
    background: transparent;
    border: none;
}

QListWidget::item:hover {
    background: #EAEAEA;
}

QListWidget::item:selected {
    background: #E0E0F0;
    color: #1E1E1E;
}

QWidget#SolutionRecentTemplateRow {
    background: transparent;
}

QLabel#SolutionRecentTemplateIcon {
    background: transparent;
}

QLabel#SolutionRecentTemplateName {
    background: transparent;
    color: #1E1E1E;
    font-size: 13px;
}

QFrame#SolutionProjectCard {
    background: transparent;
    border: none;
    border-radius: 4px;
}

QFrame#SolutionProjectCard[selected="true"] {
    background: #E0E0F0;
    border: none;
}

QFrame#SolutionProjectCard:hover {
    background: #EAEAEA;
}

QLabel#SolutionProjectName {
    color: #1E1E1E;
    font-size: 14px;
    font-weight: 500;
}

QLabel#SolutionProjectDescription {
    color: #444444;
    font-size: 12px;
}

QLabel#SolutionTagPill {
    background: transparent;
    color: #444444;
    border: 1px solid #AAAAAA;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
}

QLabel#SolutionLangBadge {
    background: #E2E2E2;
    color: #333333;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}

QLabel#SolutionRecentPath {
    color: #666666;
    font-size: 11px;
}

QFrame#SolutionProjectIconFrame {
    background: transparent;
    border: none;
}

QMenu {
    background: #DFDFDF;
    color: #1E1E1E;
    border: 1px solid #CCCCCC;
}

QMenu::item {
    background: transparent;
    padding: 6px 22px;
}

QMenu::item:selected {
    background: #4F46E5;
    color: white;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: transparent;
    margin: 0;
    border: none;
}

QScrollBar:vertical {
    width: 10px;
}

QScrollBar:horizontal {
    height: 10px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: rgba(160, 160, 160, 0.50);
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #A0A0A0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
}

QDialog {
    background: #DFDFDF;
    color: #1E1E1E;
    border: 1px solid #CCCCCC;
}

QMessageBox QLabel {
    color: #1E1E1E;
    background: transparent;
}

QLabel#HeadingLabel {
    color: #1E1E1E;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}

QLabel#FieldLabel {
    color: #444444;
    font-size: 12px;
    background: transparent;
}

QLabel#ProjectTypeLabel {
    color: #1E1E1E;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#DescriptionLabel {
    color: #666666;
    font-size: 12px;
    background: transparent;
}

QDialog QLineEdit {
    background: #DFDFDF;
    color: #1E1E1E;
    border: 1px solid #CCCCCC;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 13px;
}

QDialog QLineEdit:focus {
    border: 1px solid #4F46E5;
}

QDialog QLineEdit::placeholder {
    color: #8A8A8A;
}

QDialog QPushButton {
    background: #FFFFFF;
    color: #1E1E1E;
    border: 1px solid #CCCCCC;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
}

QDialog QPushButton:hover {
    background: #EAEAEA;
    border-color: #999999;
}

QDialog QPushButton#PrimaryButton {
    background: #4F46E5;
    color: white;
    border: none;
    font-weight: bold;
}

QDialog QPushButton#PrimaryButton:hover {
    background: #5B5BD6;
}
