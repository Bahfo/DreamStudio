QMainWindow {
    background-color: #1E1E1E;
}

QWidget#BannerWidget {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #2A2D3E,
        stop: 0.5 #252526,
        stop: 1 #1E1E2E
    );
    border-bottom: 2px solid #3C3C3C;
}

QLabel#BannerTitle {
    color: #FFFFFF; 
    font-size: 40px;
    background-color: transparent; 
}

QLabel#SectionHeader {
    color: #AAAAAA;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 16px;
    font-weight: bold;
    border-bottom: 1px solid #3C3C3C;
    padding-bottom: 4px;
}

QPushButton#ActionLink, QPushButton#RecentLink {
    background-color: transparent;
    border: none;
    color: #4FC1FF;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
    text-align: left;
    padding: 2px 0px;
}

QPushButton#RecentLink {
    font-size: 13px;
    color: #BBBBBB;
}

QPushButton#ActionLink:hover, QPushButton#RecentLink:hover {
    color: #8AD4FF;
    text-decoration: underline;
}

QCheckBox {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 12px;
    color: #BBBBBB;
}

QLabel#ActiveTab {
    color: #E0E0E0;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 18px;
    padding: 4px 10px;
    border-bottom: 2px solid #4FC1FF;
}

QLabel#InactiveTab {
    color: #888888;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 18px;
    padding: 4px 10px;
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
}

QPushButton#SubNavLink {
    background-color: transparent;
    border: none;
    color: #4FC1FF;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#SubNavLink:hover {
    color: #8AD4FF;
    text-decoration: underline;
}

QFrame#NewsBox {
    background-color: #2A2D3E;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
}

QLabel#NewsBoxTitle {
    color: #E0E0E0;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 15px;
    font-weight: bold;
}

QLabel#NewsBoxDescription {
    color: #BBBBBB;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    line-height: 18px;
}
